//@version=6
indicator("顺势指标", "CCI")
length = input.int(20, "周期", minval = 1)
src = input.source(hlc3, "源")
ma = ta.sma(src, length)
cci = (src - ma) / (0.015 * ta.dev(src, length))
plot(cci, "CCI", color = #2962FF)
band1 = hline(100, "上沿", color = #787B86)
hline(0, "中线", color = color.new(#787B86, 50))
band0 = hline(-100, "下沿", color = #787B86)
fill(band1, band0, color = color.rgb(33, 150, 243, 90), title = "背景")
