//@version=6
indicator("一目均衡表", "Ichimoku", overlay = true)
conversionPeriods = input.int(9, "转换线周期", minval = 1)
basePeriods = input.int(26, "基准线周期", minval = 1)
laggingSpan2Periods = input.int(52, "先行带 B 周期", minval = 1)
displacement = input.int(26, "位移", minval = 1)
donchian(len) => math.avg(ta.lowest(len), ta.highest(len))
conversionLine = donchian(conversionPeriods)
baseLine = donchian(basePeriods)
leadLine1 = math.avg(conversionLine, baseLine)
leadLine2 = donchian(laggingSpan2Periods)
plot(conversionLine, "转换线", color = #2962FF)
plot(baseLine, "基准线", color = #B71C1C)
plot(close, "迟行带", offset = -displacement + 1, color = #43A047)
p1 = plot(leadLine1, "先行带 A", offset = displacement - 1, color = #A5D6A7)
p2 = plot(leadLine2, "先行带 B", offset = displacement - 1, color = #EF9A9A)
fill(p1, p2, color = leadLine1 > leadLine2 ? color.rgb(67, 160, 71, 90) : color.rgb(244, 67, 54, 90), title = "云")
