//@version=6
indicator("唐奇安通道", "DC", overlay = true)
length = input.int(20, "周期", minval = 1)
offset = input.int(0, "偏移", minval = -500, maxval = 500)
lower = ta.lowest(length)
upper = ta.highest(length)
basis = math.avg(upper, lower)
plot(basis, "中轨", color = #FF6D00, offset = offset)
u = plot(upper, "上轨", color = #2962FF, offset = offset)
l = plot(lower, "下轨", color = #2962FF, offset = offset)
fill(u, l, color = color.rgb(33, 150, 243, 95), title = "背景")
