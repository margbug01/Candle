//@version=6
indicator("随机相对强弱指数", "StochRSI")
smoothK = input.int(3, "K", minval = 1)
smoothD = input.int(3, "D", minval = 1)
lengthRSI = input.int(14, "RSI 周期", minval = 1)
lengthStoch = input.int(14, "随机周期", minval = 1)
src = input.source(close, "RSI 源")
rsi1 = ta.rsi(src, lengthRSI)
k = ta.sma(ta.stoch(rsi1, rsi1, rsi1, lengthStoch), smoothK)
d = ta.sma(k, smoothD)
plot(k, "K", color = #2962FF)
plot(d, "D", color = #FF6D00)
h0 = hline(80, "上沿", color = #787B86)
hline(50, "中线", color = color.new(#787B86, 50))
h1 = hline(20, "下沿", color = #787B86)
fill(h0, h1, color = color.rgb(33, 150, 243, 90), title = "背景")
