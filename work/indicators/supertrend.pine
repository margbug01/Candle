//@version=6
indicator("超级趋势", "SuperTrend", overlay = true)
atrPeriod = input.int(10, "ATR 周期", minval = 1)
factor = input.float(3.0, "倍数", minval = 0.01, step = 0.01)
[supertrend, direction] = ta.supertrend(factor, atrPeriod)
supertrend := barstate.isfirst ? na : supertrend
upTrend = plot(direction < 0 ? supertrend : na, "上升趋势", color = color.green, style = plot.style_linebr)
downTrend = plot(direction < 0 ? na : supertrend, "下降趋势", color = color.red, style = plot.style_linebr)
bodyMiddle = plot(barstate.isfirst ? na : (open + close) / 2, "实体中点", display = display.none)
fill(bodyMiddle, upTrend, color.new(color.green, 90), title = "上升背景")
fill(bodyMiddle, downTrend, color.new(color.red, 90), title = "下降背景")
