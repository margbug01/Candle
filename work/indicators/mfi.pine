//@version=6
indicator("资金流量指数", "MFI", precision = 2)
length = input.int(14, "周期", minval = 1, maxval = 2000)
src = hlc3
mf = ta.mfi(src, length)
plot(mf, "MF", color = #7E57C2)
overbought = hline(80, "超买", color = #787B86)
hline(50, "中线", color = color.new(#787B86, 50))
oversold = hline(20, "超卖", color = #787B86)
fill(overbought, oversold, color = color.rgb(126, 87, 194, 90), title = "背景")
