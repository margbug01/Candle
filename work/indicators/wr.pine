//@version=6
indicator("威廉指标", "WR", precision = 2)
length = input.int(14, "周期", minval = 1)
src = input.source(close, "源")
_pr(length) =>
    max = ta.highest(length)
    min = ta.lowest(length)
    100 * (src - max) / (max - min)
percentR = _pr(length)
obLevel = hline(-20, "超买", color = #787B86)
hline(-50, "中线", color = color.new(#787B86, 50))
osLevel = hline(-80, "超卖", color = #787B86)
fill(obLevel, osLevel, color = color.rgb(126, 87, 194, 90), title = "背景")
plot(percentR, "%R", color = #7E57C2)
